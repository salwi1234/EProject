<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reports - NGO Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet" href="~/Admin/style.css" />
    <link rel="stylesheet" href="~/Admin/pages.css" />
</head>

<body>

    <aside class="sidebar" id="sidebar">

        <div class="sidebar-header">
            <div class="logo">

                <div class="logo-icon">
                    <i class="fas fa-hands-holding-heart"></i>
                </div>

                <div class="logo-text">
                    <span class="logo-name">HopeNGO</span>
                    <span class="logo-tagline">Together for Change</span>
                </div>

            </div>

            <button class="sidebar-close" id="sidebarClose">
                <i class="fas fa-times"></i>
            </button>
        </div>


        <nav class="sidebar-nav">

            <div class="nav-section">

                <span class="nav-label">MAIN MENU</span>

                <ul>

                    <li>
                        <a href="~/Admin/index.html" class="nav-link">
                            <i class="fas fa-chart-pie"></i>
                            <span>Dashboard</span>
                            <span class="badge badge-green">Live</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/donations.html" class="nav-link">
                            <i class="fas fa-hand-holding-dollar"></i>
                            <span>Donations</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/volunteers.html" class="nav-link">
                            <i class="fas fa-users"></i>
                            <span>Volunteers</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/events.html" class="nav-link">
                            <i class="fas fa-calendar-days"></i>
                            <span>Events</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/beneficiaries.html" class="nav-link">
                            <i class="fas fa-heart"></i>
                            <span>Beneficiaries</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/gallery.html" class="nav-link">
                            <i class="fas fa-images"></i>
                            <span>Gallery</span>
                        </a>
                    </li>

                </ul>

            </div>


            <div class="nav-section">

                <span class="nav-label">MANAGEMENT</span>

                <ul>

                    <li>
                        <a href="~/Admin/users.html" class="nav-link">
                            <i class="fas fa-user-shield"></i>
                            <span>Users</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/reports.html" class="nav-link active">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reports</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/contacts.html" class="nav-link">
                            <i class="fas fa-envelope"></i>
                            <span>Messages</span>
                            <span class="badge badge-red">3</span>
                        </a>
                    </li>

                    <li>
                        <a href="~/Admin/settings.html" class="nav-link">
                            <i class="fas fa-gear"></i>
                            <span>Settings</span>
                        </a>
                    </li>

                </ul>

            </div>

        </nav>


        <div class="sidebar-footer">

            <div class="admin-profile">

                <div class="avatar">

                    <img src="~/Admin/https://ui-avatars.com/api/?name=Admin+User&background=16a34a&color=fff&size=40"
                         alt="Admin" />

                    <span class="online-dot"></span>

                </div>

                <div class="admin-info">
                    <span class="admin-name">Admin User</span>
                    <span class="admin-role">Super Admin</span>
                </div>

                <button class="logout-btn">
                    <i class="fas fa-right-from-bracket"></i>
                </button>

            </div>

        </div>

    </aside>


    <div class="main-wrapper">

        <header class="topbar">

            <div class="topbar-left">

                <button class="hamburger" id="hamburger">
                    <i class="fas fa-bars"></i>
                </button>

                <div class="breadcrumb">
                    <span>Admin</span>
                    <i class="fas fa-chevron-right"></i>
                    <span class="current">Reports</span>
                </div>

            </div>


            <div class="topbar-right">

                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="search" placeholder="Search reports..." />
                </div>

                <button class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="notif-dot"></span>
                </button>

                <div class="admin-avatar-top">

                    <img src="~/Admin/https://ui-avatars.com/api/?name=Admin+User&background=16a34a&color=fff&size=36"
                         alt="Admin" />

                    <div>
                        <span class="topbar-name">Admin User</span>
                        <span class="topbar-role">Super Admin</span>
                    </div>

                </div>

            </div>

        </header>


        @RenderBody()


    </div>


    <div class="overlay" id="overlay"></div>


    <script src="~/Admin/https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/Admin/script.js"></script>
    <script src="~/Admin/pages.js"></script>


    <script>

            const barCtx = document.getElementById('repBarChart');

            if (barCtx) {

                new Chart(barCtx, {

                    type: 'bar',

                    data: {

                        labels: [
                            'Jan',
                            'Feb',
                            'Mar',
                            'Apr',
                            'May',
                            'Jun',
                            'Jul',
                            'Aug',
                            'Sep',
                            'Oct'
                        ],

                        datasets: [

                            {
                                label: 'Actual ($)',

                                data: [
                                    150000,
                                    120000,
                                    145000,
                                    160000,
                                    175000,
                                    200000,
                                    195000,
                                    210000,
                                    250000,
                                    280000
                                ],

                                backgroundColor: 'rgba(22,163,74,0.7)',

                                borderRadius: 6
                            },


                            {
                                label: 'Target ($)',

                                data: [
                                    180000,
                                    180000,
                                    180000,
                                    200000,
                                    200000,
                                    200000,
                                    220000,
                                    220000,
                                    250000,
                                    250000
                                ],

                                backgroundColor: 'rgba(37,99,235,0.2)',

                                borderColor: '#2563eb',

                                borderWidth: 2,

                                type: 'line',

                                fill: false,

                                tension: 0.4,

                                pointRadius: 4
                            }

                        ]

                    },


                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {

                                labels: {

                                    font: {
                                        family: 'Inter',
                                        size: 12
                                    }

                                }

                            }

                        },


                        scales: {

                            x: {

                                grid: {
                                    display: false
                                },

                                ticks: {

                                    font: {
                                        family: 'Inter',
                                        size: 11
                                    },

                                    color: '#94a3b8'

                                }

                            },


                            y: {

                                grid: {
                                    color: 'rgba(0,0,0,0.04)'
                                },

                                ticks: {

                                    font: {
                                        family: 'Inter',
                                        size: 11
                                    },

                                    color: '#94a3b8',

                                    callback: function(v) {
                                        return '$' + (v / 1000) + 'k';
                                    }

                                }

                            }

                        }

                    }

                });

            }


            const lineCtx = document.getElementById('repLineChart');

            if (lineCtx) {

                new Chart(lineCtx, {

                    type: 'line',

                    data: {

                        labels: [
                            'Jan',
                            'Feb',
                            'Mar',
                            'Apr',
                            'May',
                            'Jun',
                            'Jul',
                            'Aug',
                            'Sep',
                            'Oct'
                        ],

                        datasets: [

                            {
                                label: 'Volunteer Hours',

                                data: [
                                    3200,
                                    2800,
                                    3500,
                                    3800,
                                    4200,
                                    4500,
                                    4100,
                                    4800,
                                    5200,
                                    5500
                                ],

                                borderColor: '#0d9488',

                                backgroundColor: 'rgba(13,148,136,0.08)',

                                borderWidth: 2.5,

                                fill: true,

                                tension: 0.4,

                                pointRadius: 4
                            }

                        ]

                    },


                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                display: false
                            }

                        },


                        scales: {

                            x: {

                                grid: {
                                    display: false
                                },

                                ticks: {

                                    font: {
                                        family: 'Inter',
                                        size: 11
                                    },

                                    color: '#94a3b8'

                                }

                            },


                            y: {

                                grid: {
                                    color: 'rgba(0,0,0,0.04)'
                                },

                                ticks: {

                                    font: {
                                        family: 'Inter',
                                        size: 11
                                    },

                                    color: '#94a3b8'

                                }

                            }

                        }

                    }

                });

            }

    </script>


</body>

</html>
