@model IEnumerable<EProject.Models.Partner>

@{
    ViewData["Title"] = "Partners";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary">Our Partners</h1>
            <p class="text-muted">
                Organizations supporting our mission
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Partner
        </a>
    </div>

    <!-- Partner Table -->
    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Partner List</h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">
                            Partner Name
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Logo
                        </th>

                        <th>
                            Description
                        </th>

                        <th class="text-center">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="ps-4">
                                <strong class="text-primary">
                                    @item.PartnerName
                                </strong>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @item.Email
                                </span>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.LogoPath))
                                {
                                    <img src="@item.LogoPath"
                                         alt="Partner Logo"
                                         width="60"
                                         height="60"
                                         class="rounded-circle border"
                                         style="object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No Logo
                                    </span>
                                }
                            </td>

                            <td>
                                <span>
                                    @item.Description
                                </span>
                            </td>

                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@item.PartnerId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.PartnerId"
                                   class="btn btn-sm btn-info text-white">
                                    Details
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.PartnerId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>