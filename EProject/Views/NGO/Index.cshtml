@model IEnumerable<EProject.Models.NGO>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NGOName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MissionStatement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LogoPath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ContactEmail)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NGOName)
            </td>
            <td>
                @Html.DisplayFor(model => item.MissionStatement)
            </td>
            <td>
                @Html.DisplayFor(model => item.LogoPath)
            </td>
            <td>
                @Html.DisplayFor(model => item.ContactEmail)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.NGOId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.NGOId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.NGOId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
