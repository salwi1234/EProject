@model IEnumerable<EProject.Models.Query>

@{
    ViewData["Title"] = "Queries";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold text-primary">Queries</h1>
            <p class="text-muted mb-0">
                Manage user queries and admin replies
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + New Query
        </a>

    </div>

    <!-- Query Table -->
    <div class="card shadow border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Query List
            </h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>

                        <th class="ps-4">
                            Sender Name
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Message
                        </th>

                        <th>
                            Admin Reply
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="ps-4">
                                <strong class="text-primary">
                                    @item.SenderName
                                </strong>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @item.SenderEmail
                                </span>
                            </td>

                            <td>
                                @item.MessageContent
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.AdminReply))
                                {
                                    <span class="text-success">
                                        @item.AdminReply
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No reply yet
                                    </span>
                                }
                            </td>

                            <td class="text-center">

                                @if (item.IsResolved)
                                {
                                    <span class="badge bg-success">
                                        Resolved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Pending
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@item.QueryId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.QueryId"
                                   class="btn btn-sm btn-info text-white">
                                    Details
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.QueryId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>