
@model IEnumerable<EProject.Models.Donation>

@{
    ViewData["Title"] = "Donations";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary">
                <i class="bi bi-heart-fill"></i> Donations
            </h1>
            <p class="text-muted mb-0">
                Manage all donation records
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <!-- Donation Table -->
    <div class="card shadow-lg border-0">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Donation Records
            </h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Amount</th>
                            <th>Cause</th>
                            <th>Card Number</th>
                            <th>Expiry</th>
                            <th>CVV</th>
                            <th>User ID</th>
                            <th>User</th>
                            <th>NGO ID</th>
                            <th>NGO</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="badge bg-success fs-6">
                                        $ @item.Amount
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.CauseCategory
                                    </span>
                                </td>

                                <td>
                                    @item.DummyCardNumber
                                </td>

                                <td>
                                    @item.ExpiryDate
                                </td>

                                <td>
                                    @item.CVV
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.UserId
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @item.User?.FullName
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @item.NGOId
                                    </span>
                                </td>

                                <td class="fw-semibold text-primary">
                                    @item.NGO?.NGOName
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.DonationId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.DonationId"
                                       class="btn btn-sm btn-info text-white">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.DonationId"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

